# Leave empty in dev (Vite proxies /api to dashboard-api) and in Docker (nginx proxies /api).
# Set it only if the UI is served from a different origin than the API; dashboard-api allows
# http://localhost:3000 and http://localhost:5173 by default (dashboard.cors.allowed-origins).
VITE_API_BASE_URL=

# IANA timezone used to display times and to decide what "today" means.
VITE_TIMEZONE=Asia/Kolkata
